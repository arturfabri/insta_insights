# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Meta / Instagram
VITE_META_APP_ID=your_meta_app_id_here

# Server-side only (never use VITE_ prefix on these)
META_APP_SECRET=your_meta_app_secret_here
TOKEN_ENCRYPTION_KEY=generate_with__openssl_rand_-hex_32
META_TEST_ACCESS_TOKEN=optional_test_token_from_graph_api_explorer
INSTA_ACCESS_TOKEN=optional_test_token_from_instagram

# Security smoke test users (dev/staging only)
SECURITY_TEST_OWNER_EMAIL=owner_test_user_email
SECURITY_TEST_OWNER_PASSWORD=owner_test_user_password
SECURITY_TEST_OTHER_EMAIL=other_test_user_email
SECURITY_TEST_OTHER_PASSWORD=other_test_user_password
SECURITY_TEST_ALLOWED_PROJECT_REF=optional_project_ref_guard
